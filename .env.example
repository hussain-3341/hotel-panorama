# ── Site ─────────────────────────────────────────────────────────────
# Public URL used for canonical links, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.hotelpanorama.co.in

# ── Enquiry delivery ────────────────────────────────────────────────
# In production at least ONE of DATABASE_URL or SMTP_HOST must be set,
# otherwise the forms return a friendly "please call us" error instead of
# pretending to succeed. In local development, enquiries without either are
# written to .data/enquiries.jsonl.

# Email notifications (any SMTP provider: Gmail/Workspace app password,
# Zoho, Amazon SES, Brevo, Postmark, …)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown on notifications (must be allowed by your SMTP provider)
SMTP_FROM="Hotel Panorama Website <no-reply@hotelpanorama.co.in>"
# Where enquiries are delivered (defaults to the hotel email in src/content/site.ts)
ENQUIRY_TO_EMAIL=thepanorama.ahmedabad@gmail.com
# Also email the guest a "we received your enquiry" note (not a booking confirmation)
ENQUIRY_SEND_ACKNOWLEDGEMENT=false

# Optional PostgreSQL persistence (then run: npm run db:push)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hotel_panorama?schema=public"
